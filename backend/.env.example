OPENAI_API_KEY=sk-...
# Optional model overrides — leave unset to use gpt-4o for both.
# OPENAI_REVIEW_MODEL=gpt-4o
# OPENAI_EDITOR_MODEL=gpt-4o
DATABASE_URL=sqlite:///./data/doc2meeting.db
AUDIO_DIR=./data/audio
# Root folder the review server should expose. All markdown files under this
# tree are openable; alterations are saved as <name>_v<N>.md alongside the
# original. Absolute path recommended; defaults to ./reviewable when unset.
ROOT_DIR=./reviewable
