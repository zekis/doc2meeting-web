# ============================================================
# doc2meeting-web — Docker Compose environment
# Copy to .env and fill in real values before `docker compose up`
# ============================================================

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# Optional model overrides — leave unset to use gpt-4o for both.
# OPENAI_REVIEW_MODEL=gpt-4o
# OPENAI_EDITOR_MODEL=gpt-4o

# ---------- PostgreSQL ----------
POSTGRES_DB=doc2meeting
POSTGRES_USER=doc2meeting
POSTGRES_PASSWORD=change-me-strong-password

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------- JWT / Session Secrets ----------
# Both must be random strings of at least 32 characters
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
SESSION_SECRET_KEY=change-me-to-another-random-string

# ---------- URLs ----------
# OAuth callback — must match Google Console; goes through nginx in Docker
OAUTH_REDIRECT_URI=http://localhost/api/auth/google/callback
# Frontend base URL — where users land after OAuth
FRONTEND_BASE_URL=http://localhost

# ---------- Logging ----------
# LOG_FORMAT: "json" for production (Docker default), "text" for local dev
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
# LOG_FORMAT=json
# LOG_LEVEL=info

# ---------- Stripe (Billing) ----------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRO_PRICE_ID=price_pro_monthly
# STRIPE_API_PRICE_ID=price_api_monthly
# STRIPE_API_METERED_PRICE_ID=price_api_metered

# ---------- Email Inbound (Phase 6) ----------
# Shared secret for verifying inbound email webhooks (optional)
# EMAIL_WEBHOOK_SECRET=your-webhook-secret

# ---------- Telegram Bot (Phase 6) ----------
# Create via @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ---------- Port overrides (optional) ----------
# FRONTEND_PORT=80
# BACKEND_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
